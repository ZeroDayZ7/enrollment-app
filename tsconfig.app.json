{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "outDir": "./dist/out-tsc",
    "rootDir": "./src",
    "paths": {
      "@core/*": ["./src/core/*"],
      "@features/*": ["./src/features/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}