{
  // Wyciszenie błędów lintera dla at-rules w Tailwind v4 (@custom-variant itp.)
  "scss.lint.unknownAtRules": "ignore",
  "css.lint.unknownAtRules": "ignore",

  // Ukrywanie artefaktów i plików konfiguracyjnych (Explorer)
  "files.exclude": {
    "**/.angular": true,
    "**/dist": true,
    "**/logs/": true,
    "**/.env.example": true,
    "**/.env.dev.example": true,
    // "**/README.md": true,
    // "**/LICENSE": true,
    "**/SECURITY.md": true,
    "**/.gitattributes": true,
    // "**/.gitignore": true,
    "**/Dockerfile": true,
    "**/node_modules": true,

    "**/.editorconfig": true,
    "**/.postcssrc.json": true,
    "**/.prettierrc": true,
    // "**/angular.json": true,
    "**/package-lock.json": true,
  },

  // Wykluczenia z wyszukiwarki (Search)
  "search.exclude": {
    "**/.angular": true,
    "**/dist": true,
    "**/logs/": true,
    "**/.env.example": true,
    "**/.env.dev.example": true,
    "**/README.md": true,
    "**/LICENSE": true,
    "**/SECURITY.md": true,
    "**/.gitattributes": true,
    "**/node_modules": true,

    "**/.editorconfig": true,
    "**/.postcssrc.json": true,
    "**/.prettierrc": true,
    "**/angular.json": true,
    "**/package-lock.json": true,
  },

  // Konfiguracja edytora i formatowania pod Angular / TypeScript
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    },
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[html]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[scss]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.css-language-features"
  },

  "editor.rulers": [120, 150]
}